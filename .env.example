FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_REFRESH_SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/edumanage_pro
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/edumanage_pro_test
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
RATE_LIMIT_DEFAULT=200 per day;50 per hour
